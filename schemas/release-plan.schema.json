{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LicoLand/.github/main/schemas/release-plan.schema.json",
  "title": "LicoLand repository release plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "repository",
    "profile",
    "currentVersion",
    "versionSources",
    "changelog",
    "nextRelease",
    "releases",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": 2
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "profile": {
      "enum": [
        "governance",
        "continuous-site",
        "inactive",
        "semver",
        "component-semver"
      ]
    },
    "currentVersion": {
      "$ref": "#/$defs/nullableSemver"
    },
    "versionSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versionSource"
      }
    },
    "changelog": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "nextRelease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/releasePlan"
        }
      ]
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/releaseRecord"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "stableSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?![^/?#]*@)[^\\s/?#]+(?:[/?#][^\\s]*)?$"
    },
    "nullableSemver": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/semver"
        }
      ]
    },
    "versionSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "path",
            "pointer"
          ],
          "properties": {
            "format": {
              "const": "json"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:|/.*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "path",
            "key"
          ],
          "properties": {
            "format": {
              "const": "toml"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "path"
          ],
          "properties": {
            "format": {
              "const": "text"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "path",
            "pattern"
          ],
          "properties": {
            "format": {
              "const": "regex"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "featureRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "status",
        "pullRequest",
        "dependsOn",
        "risk",
        "acceptance",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/featureId"
        },
        "type": {
          "enum": [
            "capability",
            "breaking",
            "fix"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "blocked",
            "accepted"
          ]
        },
        "pullRequest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/httpsUri"
            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/featureRef"
          }
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "releaseCore": {
      "type": "object",
      "required": [
        "version",
        "classification",
        "status",
        "targetDate",
        "integrationBranch",
        "features",
        "blockers"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/stableSemver"
        },
        "classification": {
          "enum": [
            "initial",
            "stabilization",
            "major",
            "minor",
            "patch"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "blocked",
            "ready"
          ]
        },
        "targetDate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "integrationBranch": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "maxLength": 255
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "releasePlan": {
      "allOf": [
        {
          "$ref": "#/$defs/releaseCore"
        }
      ],
      "unevaluatedProperties": false
    },
    "releaseRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/releaseCore"
        },
        {
          "type": "object",
          "required": [
            "releasedAt",
            "releaseUrl"
          ],
          "properties": {
            "releasedAt": {
              "type": "string",
              "format": "date-time"
            },
            "releaseUrl": {
              "$ref": "#/$defs/httpsUri"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "currentVersion",
        "versionSources",
        "changelog",
        "nextRelease",
        "releases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "currentVersion": {
          "$ref": "#/$defs/nullableSemver"
        },
        "versionSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/versionSource"
          }
        },
        "changelog": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "nextRelease": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/releasePlan"
            }
          ]
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseRecord"
          }
        }
      }
    }
  }
}
